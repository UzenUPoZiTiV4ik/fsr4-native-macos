    // helper pack_s8: it shadows the intrinsic and dxc emits truncating packs.)
    return (uint)pack_clamp_s8(q);
}

int int16_wrap(int v)
{
    return ((v & 0xFFFF) ^ 0x8000) - 0x8000;
}

